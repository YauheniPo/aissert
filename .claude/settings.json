{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/claude/hook_pre_tool_guard.py",
            "timeout": 5000,
            "statusMessage": "Checking aissert guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/claude/hook_post_tool_invariants.py",
            "timeout": 5000,
            "statusMessage": "Checking aissert invariants"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/wiki/hook_session_start.py 2>/dev/null || true",
            "timeout": 15000,
            "statusMessage": "Loading LLM wiki read-plan"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/claude/hook_stop_verify.py",
            "timeout": 120000,
            "statusMessage": "Verifying aissert changes"
          }
        ]
      }
    ]
  }
}
